# Desarrollo local: copiá como .dev.vars o .env. Nunca subas valores reales.
ENVIRONMENT=development
GATEWAY_SHARED_SECRET=reemplaza-por-el-secreto-del-api-gateway
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=FlyBotyInstruccion
MONGODB_DB=FlyBotyInstruccion
MP_ACCESS_TOKEN=APP_USR_REEMPLAZAR
MP_WEBHOOK_SECRET=REEMPLAZAR

# Ajustes opcionales
TRUST_PROXY=false
REQUIRE_HTTPS=false
MAX_BODY_SIZE=32kb
SIGNATURE_MAX_AGE_SECONDS=300
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120
HEALTH_RATE_LIMIT_WINDOW_MS=86400000
HEALTH_RATE_LIMIT_MAX=10
WEBHOOK_EVENT_RETENTION_DAYS=90
LOG_WEBHOOK_PAYLOADS=false
ALLOWED_WEBHOOK_IPS=
